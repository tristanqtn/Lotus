{
  "manifest_version": 3,
  "name": "Lotus",
  "version": "3.0.0",
  "description": "Capture and replay network requests in DevTools.",
  "permissions": [
    "webRequest",
    "storage",
    "unlimitedStorage",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }
}
